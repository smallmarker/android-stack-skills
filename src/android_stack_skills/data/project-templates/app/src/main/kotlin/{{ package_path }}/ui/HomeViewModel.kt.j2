package {{ package }}.ui

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import {{ package }}.data.HomeRepository
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch
{% if hilt %}import dagger.hilt.android.lifecycle.HiltViewModel
import javax.inject.Inject
{% endif %}
sealed interface HomeState {
    data object Loading : HomeState
    data class Ready(val message: String) : HomeState
    data object Error : HomeState
}
{% if hilt %}@HiltViewModel
class HomeViewModel @Inject constructor(private val repository: HomeRepository) : ViewModel() {
{% else %}class HomeViewModel(private val repository: HomeRepository = HomeRepository()) : ViewModel() {
{% endif %}    private val mutableState = MutableStateFlow<HomeState>(HomeState.Loading)
    val state = mutableState.asStateFlow()
    init { refresh() }
    fun refresh() {
        viewModelScope.launch {
            mutableState.value = HomeState.Loading
            try {
                mutableState.value = HomeState.Ready(repository.greeting())
            } catch (error: CancellationException) { throw error
            } catch (error: Exception) { mutableState.value = HomeState.Error }
        }
    }
}
